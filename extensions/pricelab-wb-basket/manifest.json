{
  "manifest_version": 3,
  "name": "PriceLab — артикулы корзины WB",
  "description": "Собирает артикулы товаров из корзины Wildberries и копирует их для PriceLab.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PriceLab: артикулы корзины",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "*://www.wildberries.ru/*",
    "*://wildberries.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.wildberries.ru/lk/basket*",
        "*://wildberries.ru/lk/basket*"
      ],
      "js": ["extract.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
