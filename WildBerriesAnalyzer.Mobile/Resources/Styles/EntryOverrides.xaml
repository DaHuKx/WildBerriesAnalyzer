<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Жёсткие контрастные цвета: Material не должен оставлять текст «в цвет фона». -->
    <Style TargetType="Entry" ApplyToDerivedTypes="True">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#0F1C1A, Dark=#F5FFFD}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#FFFFFF, Dark=#13201E}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light=#8A9A97, Dark=#8AA09C}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor" ApplyToDerivedTypes="True">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light=#0F1C1A, Dark=#F5FFFD}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light=#FFFFFF, Dark=#13201E}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light=#8A9A97, Dark=#8AA09C}" />
    </Style>

</ResourceDictionary>
