<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>WildBerriesAnalyzer.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseMaterial3>true</UseMaterial3>
		<AndroidSdkDirectory>E:\Android\android-sdk</AndroidSdkDirectory>
		<JavaSdkDirectory>E:\Android\Jdk</JavaSdkDirectory>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>PriceLab</ApplicationTitle>
		<ApplicationId>com.companyname.wildberriesanalyzer.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0.23</ApplicationDisplayVersion>
		<!-- Android/iOS store build number (целое); продуктовая версия — ApplicationDisplayVersion. -->
		<ApplicationVersion>23</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Только arm64: на телефоне исключает известные сбои resource id / Fragment на ABI mix -->
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm64</RuntimeIdentifiers>
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F766E" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F766E" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.71" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Prism.DryIoc.Maui" Version="9.0.537" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WildBerriesAnalyzer.Domain\WildBerriesAnalyzer.Domain.csproj" />
		<ProjectReference Include="..\WildBerriesAnalyzer.Business\WildBerriesAnalyzer.Business.csproj" />
		<ProjectReference Include="..\WildBerriesAnalyzer.ServerClient\WildBerriesAnalyzer.ServerClient.csproj" />
	</ItemGroup>

	<!-- После установки на устройство: проброс localhost телефона → API на ПК -->
	<Target Name="AdbReverseApiPort" AfterTargets="Install" Condition="$(TargetFramework.Contains('-android'))">
		<PropertyGroup>
			<_AdbExe Condition="Exists('$(AndroidSdkDirectory)\platform-tools\adb.exe')">$(AndroidSdkDirectory)\platform-tools\adb.exe</_AdbExe>
			<_AdbExe Condition="'$(_AdbExe)' == '' and Exists('$(AndroidSdkDirectory)/platform-tools/adb.exe')">$(AndroidSdkDirectory)/platform-tools/adb.exe</_AdbExe>
		</PropertyGroup>
		<Exec Command="&quot;$(_AdbExe)&quot; reverse tcp:5146 tcp:5146" Condition="'$(_AdbExe)' != ''" IgnoreExitCode="true" ContinueOnError="true" />
		<Message Importance="high" Text="adb reverse tcp:5146 tcp:5146 (API для телефона через USB)" Condition="'$(_AdbExe)' != ''" />
	</Target>

</Project>
