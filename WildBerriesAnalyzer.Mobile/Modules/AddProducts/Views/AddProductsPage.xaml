<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.AddProducts.ViewModels"
             xmlns:models="clr-namespace:WildBerriesAnalyzer.Modules.Products.Models"
             x:Class="WildBerriesAnalyzer.Modules.AddProducts.Views.AddProductsPage"
             x:Name="AddProductsRoot"
             x:DataType="viewModels:AddProductsPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid Padding="12">
        <ScrollView HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Default"
                    Scrolled="OnResultsScroll">
            <VerticalStackLayout Spacing="12"
                                 Padding="0,0,0,72"
                                 HorizontalOptions="Fill">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      HorizontalOptions="Fill">
                    <Image Source="pricelab_logo"
                           WidthRequest="40"
                           HeightRequest="40"
                           Aspect="AspectFit"
                           VerticalOptions="Start" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Fill">
                        <Label Text="{Binding BrandLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5" />
                        <Label Text="{Binding Title}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="20"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding Subtitle}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Mode tabs -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        Padding="10"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button Text="По артикулу"
                                Command="{Binding ShowArticlesTabCommand}"
                                BackgroundColor="{Binding ArticlesTabBackground}"
                                TextColor="{Binding ArticlesTabTextColor}"
                                FontSize="14"
                                HeightRequest="44"
                                CornerRadius="10"
                                Padding="8,0" />
                        <Button Grid.Column="1"
                                Text="По названию"
                                Command="{Binding ShowNameTabCommand}"
                                BackgroundColor="{Binding NameTabBackground}"
                                TextColor="{Binding NameTabTextColor}"
                                FontSize="14"
                                HeightRequest="44"
                                CornerRadius="10"
                                Padding="8,0" />
                    </Grid>
                </Border>

                <!-- Articles form -->
                <Border IsVisible="{Binding IsArticlesTab}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        Padding="12"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Fill">
                        <Label Text="Артикулы или ссылки"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <VerticalStackLayout Spacing="4"
                                             HorizontalOptions="Fill">
                            <Label Text="Магазин"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   FontSize="13" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Padding="8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Picker Title="Выберите магазин"
                                        ItemsSource="{Binding ArticleMarketOptions}"
                                        SelectedItem="{Binding SelectedArticleMarket}"
                                        ItemDisplayBinding="{Binding Title}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        TitleColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding ArticlesHintText}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="13" />

                        <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Padding="8,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Editor Text="{Binding ArticlesText}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="96"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    Placeholder="{Binding ArticlesPlaceholder}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        </Border>

                        <Button Text="Добавить в каталог"
                                Command="{Binding AddByArticlesCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                TextColor="White"
                                HeightRequest="44"
                                CornerRadius="10"
                                FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Name form -->
                <Border IsVisible="{Binding IsNameTab}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        Padding="12"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Fill">
                        <Label Text="Поиск по названию"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Выберите магазины и введите название товара"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="13" />

                        <HorizontalStackLayout Spacing="16"
                                               HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="6"
                                                   VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding SearchWildberries}"
                                          Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                          VerticalOptions="Center" />
                                <Label Text="Wildberries"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6"
                                                   VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding SearchOzon}"
                                          Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                          VerticalOptions="Center" />
                                <Label Text="Ozon"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Padding="8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding ProductNameText}"
                                   Placeholder="Например: iPhone 14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                   ReturnCommand="{Binding SearchByNameCommand}" />
                        </Border>

                        <Button Text="Найти"
                                Command="{Binding SearchByNameCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                TextColor="White"
                                HeightRequest="44"
                                CornerRadius="10"
                                FontSize="14" />

                        <Button Text="Добавить в каталог"
                                Command="{Binding AddByNameCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}"
                                HeightRequest="44"
                                CornerRadius="10"
                                FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Loading -->
                <VerticalStackLayout IsVisible="{Binding IsInitialLoading}"
                                     Spacing="12"
                                     Padding="0,24"
                                     HorizontalOptions="Fill">
                    <ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding SearchProgressText}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Results header -->
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasResults}">
                    <Label Text="Результат"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding CountText}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="13"
                           VerticalOptions="Center" />
                </Grid>

                <Label Text="{Binding EmptyMessage}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                       HorizontalTextAlignment="Center"
                       Margin="8,12"
                       IsVisible="{Binding ShowEmptyMessage}" />

                <!-- Каталог WB: 2 колонки -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Results}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Start"
                            HorizontalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductListItem">
                            <VerticalStackLayout Spacing="4"
                                                 Margin="0,0,0,14"
                                                 WidthRequest="{Binding Source={x:Reference AddProductsRoot}, Path=TileWidth}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference AddProductsRoot}, Path=BindingContext.OpenLinkCommand}"
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Grid HeightRequest="{Binding Source={x:Reference AddProductsRoot}, Path=TileImageHeight}"
                                      HorizontalOptions="Fill">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                               IsVisible="{Binding IsImageLoading}"
                                                               Color="{StaticResource Primary}"
                                                               WidthRequest="28"
                                                               HeightRequest="28"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                            <Image Source="{Binding DisplayImage}"
                                                   IsVisible="{Binding HasDisplayImage}"
                                                   Opacity="{Binding AdultImageOpacity}"
                                                   Aspect="AspectFill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />
                                            <Border IsVisible="{Binding IsAdultContentRestricted}"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#B31A1A1A"
                                                    InputTransparent="True"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout VerticalOptions="Center"
                                                                     HorizontalOptions="Center"
                                                                     Spacing="2">
                                                    <Label Text="18+"
                                                           FontAttributes="Bold"
                                                           FontSize="22"
                                                           TextColor="White"
                                                           HorizontalTextAlignment="Center" />
                                                    <Label Text="Скрыто"
                                                           FontSize="11"
                                                           TextColor="#E0FFFFFF"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{Binding MarketBadgeColor}"
                                            WidthRequest="34"
                                            HeightRequest="20"
                                            Margin="8"
                                            Padding="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            InputTransparent="True">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding MarketBadgeLabel}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="10"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Brand}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Name}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="★"
                                           TextColor="#F97316"
                                           FontSize="11" />
                                    <Label Text="{Binding RatingText}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding FeedBacksText, StringFormat='  {0} оценок'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                           FontSize="11" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding ArticleText, StringFormat='Арт. {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                       FontSize="11"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid HeightRequest="40"
                      Padding="0,4"
                      IsVisible="{Binding IsLoadingMore}">
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Snackbar -->
        <Border IsVisible="{Binding IsSnackbarVisible}"
                BackgroundColor="{Binding SnackbarBackground}"
                StrokeThickness="0"
                Padding="16,14"
                Margin="0,0,0,8"
                MaximumWidthRequest="560"
                HorizontalOptions="Center"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.25" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissSnackbarCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="{Binding SnackbarMessage}"
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
                <Label Grid.Column="1"
                       Text="✕"
                       TextColor="White"
                       FontSize="16"
                       VerticalOptions="Center"
                       Opacity="0.85" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
