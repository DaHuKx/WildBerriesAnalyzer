<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.Auth.ViewModels"
             x:Class="WildBerriesAnalyzer.Modules.Auth.Views.LoginPage"
             x:DataType="viewModels:LoginPageViewModel"
             Title="Вход"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             VerticalOptions="Center"
                             Spacing="16"
                             MaximumWidthRequest="420"
                             HorizontalOptions="Center">

            <Image Source="pricelab_logo"
                   WidthRequest="88"
                   HeightRequest="88"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="PriceLab"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Аналитика цен и скидок"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,8" />

            <Label Text="Вход"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,4" />

            <Label Text="{Binding HintText}"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

            <Button Text="Войти через VK ID"
                    Command="{Binding LoginWithVkCommand}"
                    IsVisible="{Binding ShowVkButton}"
                    BackgroundColor="#0077FF"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10"
                    Margin="0,8,0,0" />

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ShowVkUnavailableHint}">
                <Label Text="{Binding VkUnavailableHint}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
                <Button Text="Проверить VK ID снова"
                        Command="{Binding RefreshVkCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                        HeightRequest="40" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
