<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.Products.ViewModels"
             xmlns:models="clr-namespace:WildBerriesAnalyzer.Modules.Products.Models"
             x:Class="WildBerriesAnalyzer.Modules.Products.Views.ProductsPage"
             x:Name="ProductsRoot"
             x:DataType="viewModels:ProductsPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid Padding="12">
        <!-- ScrollView сохраняет ScrollY при догрузке -->
        <ScrollView x:Name="ProductsScroll"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Default"
                    Scrolled="OnProductsScroll">
            <VerticalStackLayout Spacing="12"
                                 Padding="0,0,0,72"
                                 HorizontalOptions="Fill">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      HorizontalOptions="Fill">
                    <Image Source="pricelab_logo"
                           WidthRequest="40"
                           HeightRequest="40"
                           Aspect="AspectFit"
                           VerticalOptions="Start" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Fill">
                        <Label Text="{Binding BrandLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5" />
                        <Label Text="{Binding Title}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="20"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding Subtitle}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Initial loader -->
                <VerticalStackLayout IsVisible="{Binding IsInitialLoading}"
                                     Spacing="12"
                                     Padding="0,40,0,24"
                                     HorizontalOptions="Fill">
                    <ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       HorizontalOptions="Center" />
                    <Label Text="Загрузка товаров…"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Search card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        Padding="12"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Fill">
                        <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Padding="8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding SearchText}"
                                   Placeholder="Название товара"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                   ReturnCommand="{Binding SearchCommand}" />
                        </Border>
                        <Button Text="Найти"
                                Command="{Binding SearchCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                TextColor="White"
                                HeightRequest="44"
                                CornerRadius="10"
                                FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Filters card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        Padding="12"
                        HorizontalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFiltersCommand}" />
                                </Grid.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="Фильтры"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding FiltersExpandIcon}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding VisibleCountText}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Text="↻"
                                    Command="{Binding RefreshCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0"
                                    FontSize="18" />
                        </Grid>

                        <VerticalStackLayout Spacing="10"
                                             IsVisible="{Binding IsFiltersExpanded}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Сортировка"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13" />
                                <Picker Title="Сортировка"
                                        ItemsSource="{Binding SortOptions}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedSort}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Минимальный рейтинг"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13" />
                                <Picker Title="Минимальный рейтинг"
                                        ItemsSource="{Binding RatingOptions}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedRating}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Минимум отзывов"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13" />
                                <Picker Title="Минимум отзывов"
                                        ItemsSource="{Binding FeedBackOptions}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedFeedBack}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding HasActiveFilters}">
                                <Label Text="{Binding VisibleCountText, StringFormat='Показано: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Сбросить"
                                        Command="{Binding ClearFiltersCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="8,0" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Товары не найдены"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                       HorizontalTextAlignment="Center"
                       Margin="8,12"
                       IsVisible="{Binding ShowEmptyMessage}" />

                <!-- Каталог WB: 2 колонки, фото сверху, текст снизу -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Products}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Start"
                            HorizontalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductListItem">
                            <VerticalStackLayout Spacing="4"
                                                 Margin="0,0,0,14"
                                                 WidthRequest="{Binding Source={x:Reference ProductsRoot}, Path=TileWidth}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ProductsRoot}, Path=BindingContext.OpenLinkCommand}"
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Border StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                        HeightRequest="{Binding Source={x:Reference ProductsRoot}, Path=TileImageHeight}"
                                        HorizontalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                           IsVisible="{Binding IsImageLoading}"
                                                           Color="{StaticResource Primary}"
                                                           WidthRequest="28"
                                                           HeightRequest="28"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                        <Image Source="{Binding DisplayImage}"
                                               IsVisible="{Binding HasDisplayImage}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Grid>
                                </Border>

                                <Label Text="{Binding PriceText}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       FontAttributes="Bold"
                                       FontSize="17"
                                       Margin="0,2,0,0"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Brand}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Name}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="★"
                                           TextColor="#F97316"
                                           FontSize="11" />
                                    <Label Text="{Binding RatingText}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding FeedBacksText, StringFormat='  {0} оценок'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                           FontSize="11" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid HeightRequest="40"
                      Padding="0,4">
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- In-page snackbar -->
        <Border IsVisible="{Binding IsSnackbarVisible}"
                BackgroundColor="{Binding SnackbarBackground}"
                StrokeThickness="0"
                Padding="16,14"
                Margin="0,0,0,8"
                MaximumWidthRequest="560"
                HorizontalOptions="Center"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.25" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissSnackbarCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="{Binding SnackbarMessage}"
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
                <Label Grid.Column="1"
                       Text="✕"
                       TextColor="White"
                       FontSize="16"
                       VerticalOptions="Center"
                       Opacity="0.85" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
