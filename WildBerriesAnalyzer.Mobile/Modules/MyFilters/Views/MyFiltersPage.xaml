<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.MyFilters.ViewModels"
             xmlns:models="clr-namespace:WildBerriesAnalyzer.Modules.MyFilters.Models"
             x:Class="WildBerriesAnalyzer.Modules.MyFilters.Views.MyFiltersPage"
             x:DataType="viewModels:MyFiltersPageViewModel"
             x:Name="Root"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid Padding="12"
          RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Spacing="10"
                             HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      HorizontalOptions="Fill">
                    <Image Source="pricelab_logo"
                           WidthRequest="40"
                           HeightRequest="40"
                           Aspect="AspectFit"
                           VerticalOptions="Start" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Fill">
                        <Label Text="{Binding BrandLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5" />
                        <Label Text="{Binding Title}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="20"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding Subtitle}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsPageLoading}"
                                     Spacing="12"
                                     Padding="0,24,0,12"
                                     HorizontalOptions="Fill">
                    <ActivityIndicator IsRunning="{Binding IsPageLoading}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       HorizontalOptions="Center" />
                    <Label Text="Загрузка настроек…"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <ScrollView IsVisible="{Binding IsLoaded}"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding FilterSettingsTabs}"
                                           Padding="0,0,0,4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FilterSettingsTab">
                                <Border Padding="14,8"
                                        BackgroundColor="{Binding ChipBackground}"
                                        Stroke="{Binding ChipStroke}"
                                        StrokeThickness="1.5"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectFilterSettingsTabCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}"
                                           TextColor="{Binding TitleColor}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
        </VerticalStackLayout>

        <ScrollView x:Name="FiltersScroll"
                    Grid.Row="1"
                    IsVisible="{Binding IsLoaded}"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Default"
                    Scrolled="OnFiltersScroll"
                    Margin="0,8,0,8">
            <VerticalStackLayout Spacing="12"
                                 Padding="0,0,0,16"
                                 HorizontalOptions="Fill">

                    <VerticalStackLayout IsVisible="{Binding IsTemplatesSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
                        <Label Text="Готовые шаблоны настроек. Состав корзины не изменится."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Templates}"
                                             Spacing="12"
                                             HorizontalOptions="Fill">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:FilterPreset">
                                    <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                            StrokeThickness="1"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                            Padding="14"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8"
                                                             HorizontalOptions="Fill">
                                            <Label Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label Text="{Binding Summary}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   LineBreakMode="WordWrap" />
                                            <BoxView HeightRequest="1"
                                                     Color="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                                     Margin="0,2" />
                                            <Label Text="{Binding EffectsText}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                                   LineBreakMode="WordWrap" />
                                            <Button Text="Применить шаблон"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ApplyTemplateCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                    TextColor="White"
                                                    HeightRequest="44"
                                                    CornerRadius="10"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    Margin="0,4,0,0" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Основные: источник + условия -->
                    <VerticalStackLayout IsVisible="{Binding IsMainSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
<Border x:Name="FilterSourceSection"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="12"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
<!-- Scope: fixed 2×2 Grid (no FlexLayout overflow) -->
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Какие товары отслеживать"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Выберите область применения фильтров"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="8"
                                      HorizontalOptions="Fill">

                                    <!-- [0,0] -->
                                    <Border Padding="10"
                                            BackgroundColor="{Binding FilterTypes[0].CardBackground}"
                                            Stroke="{Binding FilterTypes[0].CardStroke}"
                                            StrokeThickness="2"
                                            MinimumHeightRequest="96"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterTypeCommand}"
                                                CommandParameter="{Binding FilterTypes[0]}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="4"
                                                                 VerticalOptions="Center"
                                                                 Margin="0,0,16,0">
                                                <Label Text="{Binding FilterTypes[0].IconGlyph}"
                                                       TextColor="{Binding FilterTypes[0].IconColor}"
                                                       FontSize="20"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding FilterTypes[0].Title}"
                                                       TextColor="{Binding FilterTypes[0].TitleColor}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding FilterTypes[0].Description}"
                                                       TextColor="{Binding FilterTypes[0].DescriptionColor}"
                                                       FontSize="11"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    IsVisible="{Binding FilterTypes[0].ShowCheckmark}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- [0,1] -->
                                    <Border Grid.Column="1"
                                            Padding="10"
                                            BackgroundColor="{Binding FilterTypes[1].CardBackground}"
                                            Stroke="{Binding FilterTypes[1].CardStroke}"
                                            StrokeThickness="2"
                                            MinimumHeightRequest="96"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterTypeCommand}"
                                                CommandParameter="{Binding FilterTypes[1]}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="4"
                                                                 VerticalOptions="Center"
                                                                 Margin="0,0,16,0">
                                                <Label Text="{Binding FilterTypes[1].IconGlyph}"
                                                       TextColor="{Binding FilterTypes[1].IconColor}"
                                                       FontSize="20"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding FilterTypes[1].Title}"
                                                       TextColor="{Binding FilterTypes[1].TitleColor}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding FilterTypes[1].Description}"
                                                       TextColor="{Binding FilterTypes[1].DescriptionColor}"
                                                       FontSize="11"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    IsVisible="{Binding FilterTypes[1].ShowCheckmark}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- [1,0] -->
                                    <Border Grid.Row="1"
                                            Padding="10"
                                            BackgroundColor="{Binding FilterTypes[2].CardBackground}"
                                            Stroke="{Binding FilterTypes[2].CardStroke}"
                                            StrokeThickness="2"
                                            MinimumHeightRequest="96"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterTypeCommand}"
                                                CommandParameter="{Binding FilterTypes[2]}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="4"
                                                                 VerticalOptions="Center"
                                                                 Margin="0,0,16,0">
                                                <Label Text="{Binding FilterTypes[2].IconGlyph}"
                                                       TextColor="{Binding FilterTypes[2].IconColor}"
                                                       FontSize="20"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding FilterTypes[2].Title}"
                                                       TextColor="{Binding FilterTypes[2].TitleColor}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding FilterTypes[2].Description}"
                                                       TextColor="{Binding FilterTypes[2].DescriptionColor}"
                                                       FontSize="11"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    IsVisible="{Binding FilterTypes[2].ShowCheckmark}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- [1,1] -->
                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Padding="10"
                                            BackgroundColor="{Binding FilterTypes[3].CardBackground}"
                                            Stroke="{Binding FilterTypes[3].CardStroke}"
                                            StrokeThickness="2"
                                            MinimumHeightRequest="96"
                                            HorizontalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectFilterTypeCommand}"
                                                CommandParameter="{Binding FilterTypes[3]}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="4"
                                                                 VerticalOptions="Center"
                                                                 Margin="0,0,16,0">
                                                <Label Text="{Binding FilterTypes[3].IconGlyph}"
                                                       TextColor="{Binding FilterTypes[3].IconColor}"
                                                       FontSize="20"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding FilterTypes[3].Title}"
                                                       TextColor="{Binding FilterTypes[3].TitleColor}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding FilterTypes[3].Description}"
                                                       TextColor="{Binding FilterTypes[3].DescriptionColor}"
                                                       FontSize="11"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border WidthRequest="18"
                                                    HeightRequest="18"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    IsVisible="{Binding FilterTypes[3].ShowCheckmark}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                    </Border>

<Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="12"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Условия"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Пороги для отбора товаров со скидкой"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
<VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Fill">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                Padding="12,10"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,110"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Fill">
                                <Label Text="Минимальная скидка (%)"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Entry Text="{Binding DiscontMinPercentText}"
                                       Grid.Column="1"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#0F1C1A, Dark=#F5FFFD}"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"
                                       Focused="OnNumericEntryFocused"
                                       Unfocused="OnNumericEntryUnfocused" />
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowNonBagConditions}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                Padding="12,10"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,110"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Fill">
                                <Label Text="Минимум отзывов (шт.)"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Entry Text="{Binding MinReviewsCountText}"
                                       Grid.Column="1"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#0F1C1A, Dark=#F5FFFD}"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"
                                       Focused="OnNumericEntryFocused"
                                       Unfocused="OnNumericEntryUnfocused" />
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ShowNonBagConditions}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                StrokeThickness="1"
                                Padding="12,10"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,110"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Fill">
                                <Label Text="Минимальный рейтинг (из 5)"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />

                                <Entry Text="{Binding MinRatingText}"
                                       Grid.Column="1"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#0F1C1A, Dark=#F5FFFD}"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center"
                                       Focused="OnNumericEntryFocused"
                                       Unfocused="OnNumericEntryUnfocused"/>
                            </Grid>
                        </Border>

                        <Label IsVisible="{Binding IsOwnBagFilter}"
                               Text="Для товаров из вашей корзины учитывается только минимальная скидка — отзывы и рейтинг не проверяются."
                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>

                    <!-- Стратегии -->
                    <VerticalStackLayout IsVisible="{Binding IsStrategiesSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
<Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="12"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
<!-- Strategies -->
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Стратегии базовой цены"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Можно выбрать несколько. Если ничего не выбрано — учитываются все стратегии."
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StrategyOptions}"
                                                     Spacing="6"
                                                     HorizontalOptions="Fill">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:StrategyOption">
                                            <Border Padding="8,6"
                                                    BackgroundColor="{Binding CardBackground}"
                                                    Stroke="{Binding CardStroke}"
                                                    StrokeThickness="1"
                                                    HorizontalOptions="Fill">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="*,36"
                                                      ColumnSpacing="4"
                                                      HorizontalOptions="Fill">
                                                    <Grid ColumnDefinitions="32,*"
                                                          ColumnSpacing="6"
                                                          HorizontalOptions="Fill">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                        </Grid.GestureRecognizers>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                                  VerticalOptions="Center"
                                                                  HorizontalOptions="Center"
                                                                  WidthRequest="32"
                                                                  HeightRequest="32"
                                                                  InputTransparent="True" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               TextColor="{Binding TitleColor}"
                                                               FontSize="13"
                                                               VerticalOptions="Center"
                                                               LineBreakMode="WordWrap"
                                                               InputTransparent="True" />
                                                    </Grid>
                                                    <Button Grid.Column="1"
                                                            Text="?"
                                                            Command="{Binding ShowInfoCommand}"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="End" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>

                    <!-- Магазины -->
                    <VerticalStackLayout IsVisible="{Binding IsMarketsSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
<Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="12"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
<!-- Marketplaces -->
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Магазины"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Можно выбрать несколько. Если ничего не выбрано — учитываются все магазины."
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MarketTypeOptions}"
                                                     Spacing="6"
                                                     HorizontalOptions="Fill">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:MarketTypeOption">
                                            <Border Padding="8,6"
                                                    BackgroundColor="{Binding CardBackground}"
                                                    Stroke="{Binding CardStroke}"
                                                    StrokeThickness="1"
                                                    HorizontalOptions="Fill">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="32,Auto,*"
                                                      ColumnSpacing="8"
                                                      HorizontalOptions="Fill"
                                                      InputTransparent="True">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                              VerticalOptions="Center"
                                                              HorizontalOptions="Center"
                                                              WidthRequest="32"
                                                              HeightRequest="32" />
                                                    <Border Grid.Column="1"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{Binding BadgeColor}"
                                                            WidthRequest="34"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="5" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding BadgeLabel}"
                                                               TextColor="White"
                                                               FontAttributes="Bold"
                                                               FontSize="9"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation" />
                                                    </Border>
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Title}"
                                                           TextColor="{Binding TitleColor}"
                                                           FontSize="13"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>

                    <!-- Корзина -->
                    <VerticalStackLayout IsVisible="{Binding IsBagSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
                    <Border x:Name="BagDetailsSection"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="12"
                                    Opacity="0.05" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Товары в корзине"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding BagVisibleCountText}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Label Text="Артикулы / ссылки WB и Ozon или общая корзина (basket?shareId=… / cart?share=…)"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   FontSize="13" />

                            <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Padding="8,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Editor Text="{Binding NewArticleText}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="72"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                        Placeholder="артикул WB, ссылка Ozon или корзина share=…"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </Border>

                            <Button Text="Добавить в корзину"
                                    Command="{Binding AddArticlesCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                    TextColor="White"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontSize="14" />

                            <Button Text="Очистить корзину"
                                    Command="{Binding ClearBagCommand}"
                                    IsVisible="{Binding HasBagProducts}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                    BorderWidth="1.5"
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    FontSize="14" />

                            <Label Text="Корзина пуста"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   IsVisible="{Binding HasNoBagProducts}" />

                            <VerticalStackLayout IsVisible="{Binding HasBagProducts}"
                                                 Spacing="10">

                                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                        Padding="8,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding BagSearchText}"
                                           Placeholder="Поиск по названию, бренду, артикулу"
                                           BackgroundColor="Transparent"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                </Border>

                                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                                        Padding="10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleBagFiltersCommand}" />
                                            </Grid.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="8"
                                                                   VerticalOptions="Center">
                                                <Label Text="Фильтры"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding BagFiltersExpandIcon}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding BagVisibleCountText}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <VerticalStackLayout Spacing="8"
                                                             IsVisible="{Binding IsBagFiltersExpanded}">
                                            <Picker Title="Бренд"
                                                    ItemsSource="{Binding BagBrandOptions}"
                                                    SelectedItem="{Binding SelectedBagBrand}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />

                                            <Picker Title="Сортировка"
                                                    ItemsSource="{Binding BagSortOptions}"
                                                    SelectedItem="{Binding SelectedBagSort}"
                                                    ItemDisplayBinding="{Binding Title}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />

                                            <Grid ColumnDefinitions="*,Auto"
                                                  IsVisible="{Binding HasActiveBagFilters}">
                                                <Label Text="{Binding BagVisibleCountText, StringFormat='Показано: {0}'}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       FontSize="13"
                                                       VerticalOptions="Center" />
                                                <Button Grid.Column="1"
                                                        Text="Сбросить"
                                                        Command="{Binding ClearBagFiltersCommand}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                        FontSize="13"
                                                        HeightRequest="36"
                                                        Padding="8,0" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Label Text="Ничего не найдено"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       IsVisible="{Binding HasNoVisibleBagProducts}" />

                                <FlexLayout IsVisible="{Binding HasVisibleBagProducts}"
                                            BindableLayout.ItemsSource="{Binding BagProducts}"
                                            Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="SpaceBetween"
                                            AlignItems="Start"
                                            HorizontalOptions="Fill">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:BagProductItem">
                                            <VerticalStackLayout Spacing="4"
                                                                 Margin="0,0,0,14"
                                                                 WidthRequest="{Binding Source={x:Reference Root}, Path=TileWidth}">
                                                <Grid>
                                                    <Border StrokeThickness="0"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                                            HeightRequest="{Binding Source={x:Reference Root}, Path=TileImageHeight}"
                                                            HorizontalOptions="Fill">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="12" />
                                                        </Border.StrokeShape>
                                                        <Grid>
                                                            <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                                               IsVisible="{Binding IsImageLoading}"
                                                                               Color="{StaticResource Primary}"
                                                                               WidthRequest="28"
                                                                               HeightRequest="28"
                                                                               HorizontalOptions="Center"
                                                                               VerticalOptions="Center" />
                                                            <Image Source="{Binding DisplayImage}"
                                                                   IsVisible="{Binding HasDisplayImage}"
                                                                   Opacity="{Binding AdultImageOpacity}"
                                                                   Aspect="AspectFill"
                                                                   HorizontalOptions="Fill"
                                                                   VerticalOptions="Fill" />
                                                            <Border IsVisible="{Binding IsAdultContentRestricted}"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="#B31A1A1A"
                                                                    InputTransparent="True"
                                                                    HorizontalOptions="Fill"
                                                                    VerticalOptions="Fill">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12" />
                                                                </Border.StrokeShape>
                                                                <VerticalStackLayout VerticalOptions="Center"
                                                                                     HorizontalOptions="Center"
                                                                                     Spacing="2">
                                                                    <Label Text="18+"
                                                                           FontAttributes="Bold"
                                                                           FontSize="22"
                                                                           TextColor="White"
                                                                           HorizontalTextAlignment="Center" />
                                                                    <Label Text="Скрыто"
                                                                           FontSize="11"
                                                                           TextColor="#E0FFFFFF"
                                                                           HorizontalTextAlignment="Center" />
                                                                </VerticalStackLayout>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border StrokeThickness="0"
                                                            BackgroundColor="{Binding MarketBadgeColor}"
                                                            WidthRequest="34"
                                                            HeightRequest="20"
                                                            Margin="8"
                                                            Padding="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="End"
                                                            InputTransparent="True">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="5" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding MarketBadgeLabel}"
                                                               TextColor="White"
                                                               FontAttributes="Bold"
                                                               FontSize="10"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />
                                                    </Border>
                                                    <Button Text="✕"
                                                            Command="{Binding RemoveCommand}"
                                                            BackgroundColor="#99000000"
                                                            TextColor="White"
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            Margin="6"
                                                            FontSize="12"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start" />
                                                </Grid>

                                                <Label Text="{Binding DisplayTitle}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />
                                                <Label Text="{Binding Article, StringFormat='Арт. {0}'}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                                       FontSize="11" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <ActivityIndicator IsRunning="{Binding IsLoadingMoreBag}"
                                                   IsVisible="{Binding IsLoadingMoreBag}"
                                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                                   HeightRequest="36"
                                                   WidthRequest="36"
                                                   HorizontalOptions="Center"
                                                   Margin="0,4,0,8" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>

                    <!-- Категории -->
                    <VerticalStackLayout IsVisible="{Binding IsCategoriesSection}"
                                         Spacing="12"
                                         HorizontalOptions="Fill">
                    <Border x:Name="CategoryDetailsSection"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="12"
                                    Opacity="0.05" />
                        </Border.Shadow>

                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Категории"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Нажмите на категорию: зелёный — белый список, красный — чёрный. Режим списка выберите в «Основных»."
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Label Text="Известных категорий пока нет. Они появятся после обновления цен или добавления товаров."
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                       FontSize="12"
                                       IsVisible="{Binding HasNoCategoryOptions}" />

                                <VerticalStackLayout IsVisible="{Binding HasCategoryOptions}"
                                                     BindableLayout.ItemsSource="{Binding CategoryOptions}"
                                                     Spacing="6"
                                                     HorizontalOptions="Fill">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryListOption">
                                            <Border Padding="8,6"
                                                    BackgroundColor="{Binding CardBackground}"
                                                    Stroke="{Binding CardStroke}"
                                                    StrokeThickness="1"
                                                    HorizontalOptions="Fill">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8"
                                                      HorizontalOptions="Fill"
                                                      InputTransparent="True">
                                                    <Label Text="{Binding Name}"
                                                           TextColor="{Binding TitleColor}"
                                                           FontSize="13"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="WordWrap" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusLabel}"
                                                           TextColor="{Binding StatusColor}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasSelection}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                    </Border>
                    </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Сохранить настройки"
                Command="{Binding SaveFilterCommand}"
                Style="{StaticResource AccentButton}"
                FontSize="15"
                HeightRequest="50"
                Padding="16,0"
                CornerRadius="12"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsLoaded}">
            <Button.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource AccentBrush}, Dark={StaticResource AccentDarkBrush}}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.35" />
            </Button.Shadow>
        </Button>

<!-- Overlay: массовое добавление в корзину -->
        <Grid IsVisible="{Binding IsAddingToBag}"
              BackgroundColor="#99000000">
            <VerticalStackLayout Spacing="12"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsAddingToBag}"
                                   Color="White"
                                   HeightRequest="48"
                                   WidthRequest="48"
                                   HorizontalOptions="Center" />
                <Label Text="Добавление в корзину…"
                       TextColor="White"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- In-page snackbar (CommunityToolkit Snackbar не работает во вложенном ContentView) -->
        <Border IsVisible="{Binding IsSnackbarVisible}"
                BackgroundColor="{Binding SnackbarBackground}"
                StrokeThickness="0"
                Padding="16,14"
                Margin="0,0,0,8"
                MaximumWidthRequest="560"
                HorizontalOptions="Center"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.25" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissSnackbarCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="{Binding SnackbarMessage}"
                       TextColor="White"
                       FontSize="14"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
                <Label Grid.Column="1"
                       Text="✕"
                       TextColor="White"
                       FontSize="16"
                       VerticalOptions="Center"
                       Opacity="0.85" />
            </Grid>
        </Border>

        <!-- Strategy help dialog -->
        <Grid IsVisible="{Binding IsStrategyHelpVisible}"
              BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissStrategyHelpCommand}" />
            </Grid.GestureRecognizers>
            <Border Margin="24"
                    Padding="18"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <!-- Блокируем закрытие при тапе по карточке -->
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding StrategyHelpTitle}"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding DismissStrategyHelpCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                FontSize="16" />
                    </Grid>
                    <Label Text="{Binding StrategyHelpDescription}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           LineBreakMode="WordWrap" />
                    <Label Text="Пример"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}" />
                    <Border Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark={StaticResource SurfaceMutedDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding StrategyHelpExample}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               LineBreakMode="WordWrap" />
                    </Border>
                    <Button Text="Понятно"
                            Command="{Binding DismissStrategyHelpCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                            TextColor="White"
                            HeightRequest="44"
                            CornerRadius="10"
                            FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
