<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.MyFilters.ViewModels"
             xmlns:models="clr-namespace:WildBerriesAnalyzer.Modules.MyFilters.Models"
             x:Class="WildBerriesAnalyzer.Modules.MyFilters.Views.FilterPresetsPage"
             x:Name="PresetsRoot"
             x:DataType="viewModels:FilterPresetsPageViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="12,10"
              ColumnSpacing="8">
            <Button Text="←"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="17"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

            <BoxView Grid.Column="2"
                     WidthRequest="44"
                     HeightRequest="1"
                     Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1"
                    HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,4,16,28"
                                 Spacing="14"
                                 HorizontalOptions="Fill">

                <Label Text="{Binding Subtitle}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       LineBreakMode="WordWrap" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Presets}"
                                     Spacing="12"
                                     HorizontalOptions="Fill">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FilterPreset">
                            <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Padding="14"
                                    HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8"
                                                     HorizontalOptions="Fill">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding Summary}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           LineBreakMode="WordWrap" />
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                                             Margin="0,2" />
                                    <Label Text="{Binding EffectsText}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                           LineBreakMode="WordWrap" />
                                    <Button Text="Выбрать шаблон"
                                            Command="{Binding Source={x:Reference PresetsRoot}, Path=BindingContext.SelectPresetCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"
                                            TextColor="White"
                                            HeightRequest="44"
                                            CornerRadius="10"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
