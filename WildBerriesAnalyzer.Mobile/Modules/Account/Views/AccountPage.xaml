<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:viewModels="clr-namespace:WildBerriesAnalyzer.Modules.Account.ViewModels"

             x:Class="WildBerriesAnalyzer.Modules.Account.Views.AccountPage"

             x:DataType="viewModels:AccountPageViewModel"

             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">



    <Grid Padding="16">

        <ScrollView>

            <VerticalStackLayout Spacing="16"

                                 MaximumWidthRequest="520"

                                 HorizontalOptions="Center">



                <Grid ColumnDefinitions="*,Auto">

                    <Label Text="{Binding Title}"

                           FontSize="28"

                           FontAttributes="Bold"

                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"

                           VerticalOptions="Center" />



                    <Button Grid.Column="1"

                            Text="Обновить"

                            Command="{Binding RefreshCommand}"

                            Style="{StaticResource PrimaryButton}"

                            WidthRequest="120"

                            HeightRequest="40"

                            FontSize="14" />

                </Grid>



                <ActivityIndicator IsRunning="{Binding IsBusy}"

                                   IsVisible="{Binding IsBusy}"

                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkTheme}}"

                                   HorizontalOptions="Center" />



                <Label Text="{Binding ErrorMessage}"

                       TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"

                       FontSize="13"

                       IsVisible="{Binding HasError}"

                       HorizontalTextAlignment="Center" />



                <Label Text="{Binding StatusMessage}"

                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"

                       FontSize="13"

                       IsVisible="{Binding HasStatus}"

                       HorizontalTextAlignment="Center" />



                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"

                        StrokeThickness="1"

                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"

                        Padding="16"

                        IsVisible="{Binding IsLoaded}">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="12" />

                    </Border.StrokeShape>



                    <VerticalStackLayout Spacing="10">

                        <Label Text="Профиль"

                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"

                               FontAttributes="Bold"

                               FontSize="18" />



                        <Label FontSize="14"

                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">

                            <Label.FormattedText>

                                <FormattedString>

                                    <Span Text="Логин: " />

                                    <Span Text="{Binding Login}"

                                          TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                </FormattedString>

                            </Label.FormattedText>

                        </Label>



                        <Label FontSize="14"

                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">

                            <Label.FormattedText>

                                <FormattedString>

                                    <Span Text="VK: " />

                                    <Span Text="{Binding VkStatusText}"

                                          TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                                </FormattedString>

                            </Label.FormattedText>

                        </Label>

                    </VerticalStackLayout>

                </Border>



                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"

                        StrokeThickness="1"

                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"

                        Padding="16"

                        IsVisible="{Binding ShowLinkSection}">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="12" />

                    </Border.StrokeShape>



                    <VerticalStackLayout Spacing="12">

                        <Label Text="Привязка VK"

                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"

                               FontAttributes="Bold"

                               FontSize="18" />



                        <Label Text="Чтобы получать уведомления о скидках в VK, привяжите аккаунт. Сгенерируйте код и отправьте его боту сообщества."

                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"

                               FontSize="13"

                               LineBreakMode="WordWrap" />



                        <Button Text="Сгенерировать код"

                                Command="{Binding CreateLinkCodeCommand}"

                                Style="{StaticResource AccentButton}"

                                HeightRequest="44"

                                FontSize="14" />



                        <VerticalStackLayout Spacing="8"

                                             IsVisible="{Binding HasLinkCode}">

                            <Label Text="Код"

                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"

                                   FontSize="12" />



                            <Label Text="{Binding LinkCode}"

                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"

                                   FontAttributes="Bold"

                                   FontSize="28"

                                   CharacterSpacing="4"

                                   HorizontalTextAlignment="Center" />



                            <Label Text="{Binding LinkCodeExpiresText}"

                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"

                                   FontSize="12"

                                   HorizontalTextAlignment="Center" />



                            <Label Text="{Binding LinkInstruction}"

                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"

                                   FontSize="13"

                                   LineBreakMode="WordWrap" />



                            <Button Text="Скопировать команду"

                                    Command="{Binding CopyLinkCodeCommand}"

                                    Style="{StaticResource PrimaryButton}"

                                    HeightRequest="44"

                                    FontSize="14" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>



                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"

                        StrokeThickness="1"

                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"

                        Padding="16"

                        IsVisible="{Binding ShowUnlinkSection}">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="12" />

                    </Border.StrokeShape>



                    <VerticalStackLayout Spacing="12">

                        <Label Text="VK привязан"

                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"

                               FontAttributes="Bold"

                               FontSize="18" />



                        <Label Text="Алерты о скидках отправляются в привязанный VK-аккаунт."

                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"

                               FontSize="13" />

                    </VerticalStackLayout>

                </Border>



                <Border Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Оформление"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontAttributes="Bold"
                               FontSize="18" />

                        <Label Text="{Binding ThemeStatusText, StringFormat='Текущая тема: {0}'}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Button Text="Светлая"
                                    Command="{Binding SetThemeCommand}"
                                    CommandParameter="Light"
                                    BackgroundColor="{Binding LightThemeButtonBackground}"
                                    TextColor="{Binding LightThemeButtonTextColor}"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    FontSize="13" />
                            <Button Grid.Column="1"
                                    Text="Тёмная"
                                    Command="{Binding SetThemeCommand}"
                                    CommandParameter="Dark"
                                    BackgroundColor="{Binding DarkThemeButtonBackground}"
                                    TextColor="{Binding DarkThemeButtonTextColor}"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    FontSize="13" />
                            <Button Grid.Column="2"
                                    Text="Система"
                                    Command="{Binding SetThemeCommand}"
                                    CommandParameter="System"
                                    BackgroundColor="{Binding SystemThemeButtonBackground}"
                                    TextColor="{Binding SystemThemeButtonTextColor}"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Выйти"
                        Command="{Binding SignOutCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="48"
                        FontSize="15"
                        Margin="0,8,0,24" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentView>


