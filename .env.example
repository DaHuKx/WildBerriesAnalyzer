# Скопируйте в .env и заполните значения:
#   copy .env.example .env

POSTGRES_USER=WbAdmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=WildBerriesAnalyzerDb
POSTGRES_PORT=5432
# Хост Postgres с хост-машины / ConsoleTest (не docker-сетевое имя postgresdb):
WB_DB_HOST=62.233.35.144
# Разрешённый внешний IP для 5432 (firewall на VDS):
POSTGRES_ALLOW_IP=37.113.214.86

SERVER_PORT=5146
ASPNETCORE_ENVIRONMENT=Production

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=WildBerriesAnalyzer
JWT_AUDIENCE=WildBerriesAnalyzer.Clients

VK_BOT_GROUP_ID=219811363
VK_BOT_ACCESS_TOKEN=CHANGE_ME_VK_GROUP_TOKEN
VK_BOT_WRITE_URL=https://vk.me/club219811363

# Обязательно true — иначе Mobile скрывает кнопки VK ID
VK_ID_ENABLED=true
VK_ID_CLIENT_ID=54707637
VK_ID_SERVICE_TOKEN=
# Для Android-приложения VK ID (без поля «доверенный redirect») — канонический URI:
#   vk{CLIENT_ID}://vk.ru/blank.html
# Поле «Доверенный redirect URL» есть только у платформы Web.
VK_ID_REDIRECT_URI=vk54707637://vk.ru/blank.html
VK_ID_APP_CALLBACK_URI=vk54707637://vk.ru/blank.html

PRICE_UPDATE_ENABLED=true
PRICE_UPDATE_INTERVAL=01:00:00
PRICE_UPDATE_BATCH_SIZE=100
PRICE_UPDATE_BATCH_DELAY=00:00:03

# Актуальная (последняя) версия Mobile — semver major.minor.patch.
# Синхронизируйте с ApplicationDisplayVersion в WildBerriesAnalyzer.Mobile.csproj
MOBILE_LATEST_VERSION=1.0.23
