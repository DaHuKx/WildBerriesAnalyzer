        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="3.1.18" include="All" />
        <dependency id="Npgsql" version="4.1.9" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>