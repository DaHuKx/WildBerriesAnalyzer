<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ModerMobile.ViewModels"
             xmlns:models="clr-namespace:ModerMobile.Models"
             x:Class="ModerMobile.Pages.BulkAssignPage"
             x:DataType="vm:BulkAssignPageViewModel"
             Title="Массовое присвоение"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          Padding="16"
          RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   IsVisible="{Binding HasStatus}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#DC2626"
                   FontSize="13"
                   IsVisible="{Binding HasError}"
                   LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="32"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Категории / статусы -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="Категории"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{StaticResource TextPrimary}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Stroke="{StaticResource Outline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Поиск или новая категория…"
                           Text="{Binding CategorySearchText}"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing" />
                </Border>
                <Button Grid.Column="1"
                        Text="Добавить"
                        Command="{Binding AddCategoryCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="13"
                        Padding="12,0"
                        HeightRequest="40"
                        CornerRadius="10" />
            </Grid>
            <CollectionView ItemsSource="{Binding FilteredCategories}"
                            SelectionMode="None"
                            HeightRequest="140">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryOption">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              Padding="2,4">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Color="{StaticResource Primary}"
                                      VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Диапазон ID -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="Диапазон ID"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{StaticResource TextPrimary}" />
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
                <Border Stroke="{StaticResource Outline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Начальный ID"
                           Text="{Binding FromIdText}"
                           Keyboard="Numeric"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           BackgroundColor="Transparent" />
                </Border>
                <Border Grid.Column="1"
                        Stroke="{StaticResource Outline}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Конечный ID"
                           Text="{Binding ToIdText}"
                           Keyboard="Numeric"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           BackgroundColor="Transparent" />
                </Border>
            </Grid>
            <Button Text="Выделить по диапазону"
                    Command="{Binding ApplyRangeCommand}"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{StaticResource TextPrimary}"
                    HeightRequest="40"
                    CornerRadius="10"
                    FontSize="14" />
        </VerticalStackLayout>

        <Label Grid.Row="3"
               Text="Товары без категории"
               FontAttributes="Bold"
               FontSize="16"
               TextColor="{StaticResource TextPrimary}" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProductOption">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10"
                          Padding="2,8">
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  Color="{StaticResource Primary}"
                                  VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding DisplayText}"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Нет товаров без категории"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Grid Grid.Row="5"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Button Text="Обновить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{StaticResource TextPrimary}"
                    HeightRequest="48"
                    CornerRadius="12" />
            <Button Grid.Column="1"
                    Text="Сохранить"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="48"
                    CornerRadius="12" />
        </Grid>
    </Grid>
</ContentPage>
